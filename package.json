{
  "name": "aniki",
  "version": "2.0.0-beta.1",
  "description": "Node.js API wrapper for anime/manga related content.",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "default": "./src/index.js",
      "require": "./src/index.js",
      "types": "./types/index.d.ts"
    },
    "./funcs": {
      "default": "./src/funcs/index.js",
      "require": "./src/funcs/index.js",
      "types": "./types/funcs/index.d.ts"
    },
    "./consts": {
      "default": "./src/consts/index.js",
      "require": "./src/consts/index.js",
      "types": "./types/consts/index.d.ts"
    },
    "./kitsu": {
      "default": "./src/apis/kitsu/index.js",
      "require": "./src/apis/kitsu/index.js",
      "types": "./types/apis/kitsu/index.d.ts"
    },
    "./myanimelist": {
      "default": "./src/apis/myanimelist/index.js",
      "require": "./src/apis/myanimelist/index.js",
      "types": "./types/apis/myanimelist/index.d.ts"
    },
    "./waifuim": {
      "default": "./src/apis/waifuim/index.js",
      "require": "./src/apis/waifuim/index.js",
      "types": "./types/apis/waifuim/index.d.ts"
    },
    "./waifuit": {
      "default": "./src/apis/waifuit/index.js",
      "require": "./src/apis/waifuit/index.js",
      "types": "./types/apis/waifuit/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Normioffi/Aniki.git"
  },
  "keywords": [
    "aniki",
    "api",
    "anime",
    "anime-info",
    "anime-api",
    "manga",
    "manga-api",
    "manga-info",
    "kitsu",
    "anime-kitsu",
    "manga-kitsu",
    "myanimelist",
    "mymangalist",
    "mal",
    "anime-mal",
    "manga-mal",
    "waifu",
    "waifuim",
    "waifu-im",
    "waifuit",
    "waifu-it"
  ],
  "author": "normioffi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Normioffi/Aniki/issues"
  },
  "homepage": "https://github.com/Normioffi/Aniki/tree/beta#readme",
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.13"
  }
}
